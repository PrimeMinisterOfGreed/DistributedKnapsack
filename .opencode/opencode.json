{
    "$schema": "https://opencode.ai/config.json",
      "provider": {
    "cluster": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cluster",
      "options": {
        "baseURL": "http://10.0.15.40:5000/qwen/v1"
      },
      "models": {
        "Qwen3.5": {
          "name": "Qwen3.5",
          "options": {
            "max_tokens": 32000
          }
        }
      }
    }
  },
    "autoupdate": true,
    "server": {
        "port": 4096
    },
    "lsp": {
        "clangd": {
            "command": [
                "clangd",
                "--background-index",
                "--clang-tidy",
                "--completion-style=detailed",
                "--header-insertion=never"
            ],
        }
    }
}
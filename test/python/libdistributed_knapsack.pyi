def knapsackcopasequential(args: KnapsackArguments) -> KnapsackResult: ...
def knapsackcopampi(args: KnapsackArguments, numThreads: int = 1) -> KnapsackResult: ...
def knapsackdpmpi(args: KnapsackArguments) -> KnapsackResult: ...
{
  "version": 8,
  "configurePresets": [
    {
      "name": "default-clang",
      "displayName": "Clang 20.1.2 x86_64-pc-linux-gnu",
      "description": "Uso dei compilatori: C = /usr/bin/clang, CXX = /usr/bin/clang++",
      "binaryDir": "build",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_C_COMPILER": "clang-20",
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "use_conan",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake"
      }
    },
    {
      "name": "default",
      "displayName": "GCC",
      "description": "Uso dei compilatori: C = /usr/bin/gcc, CXX = /usr/bin/g++",
      "binaryDir": "build",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KP_GPU": "OFF",
        "KP_MPI": "OFF"
      }
    },
    {
      "name": "mpi",
      "inherits": [
        "default"
      ],
      "cacheVariables": {
        "KP_GPU": "OFF",
        "KP_MPI": "ON"
      }
    },
    {
      "name": "gpu",
      "inherits": [
        "default"
      ],
      "cacheVariables": {
        "KP_GPU": "ON",
        "KP_MPI": "OFF"
      }
    },
    {
      "name": "all",
      "inherits": [
        "default"
      ],
      "cacheVariables": {
        "KP_GPU": "ON",
        "KP_MPI": "ON"
      }
    },
    {
      "name": "release-gcc",
      "displayName": "GCC Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}

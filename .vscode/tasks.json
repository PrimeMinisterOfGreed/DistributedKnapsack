{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "cmake --build build",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "cmake-configure-clang",
            "type": "shell",
            "command": "cmake --preset default-clang",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "run-mpi-tests",
            "type": "shell",
            "command": "mpirun -np 2 ${workspaceFolder}/build/test/mpi/distributed_knapsack_mpi_tests",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "run-unit-tests",
            "type": "shell",
            "command": "${workspaceFolder}/build/test/distributed_knapsack_tests",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}

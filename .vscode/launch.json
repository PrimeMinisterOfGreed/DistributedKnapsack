{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run MPI Tests (2 processes)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/mpirun",
            "args": [
                "-np",
                "2",
                "${workspaceFolder}/build/test/mpi/distributed_knapsack_mpi_tests"
            ],
            "preLaunchTask": "cmake-build",
            "environment": [
                {
                    "name": "OMPI_MCA_rmaps_base_oversubscribe",
                    "value": "1"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Run Unit Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test/distributed_knapsack_tests",
            "args": [],
            "preLaunchTask": "cmake-build",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
